/**
 * Golden-vector test for the browser-side rubric port.
 *
 * `web/tests/golden/rubric_golden.json` is generated by the Python export step
 * from the real check implementations. The TypeScript port must reproduce the
 * same scores and severities, which is what makes the in-browser checker
 * trustworthy rather than a lookalike.
 */
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import test from "node:test";

import { evaluateDataset, type Dataset, type RubricConfig } from "../lib/rubric.ts";

const here = dirname(fileURLToPath(import.meta.url));
const golden = JSON.parse(readFileSync(join(here, "golden", "rubric_golden.json"), "utf8")) as {
  config: RubricConfig;
  cases: {
    name: string;
    feature_names: string[];
    X_train: (number | null)[][];
    y_train: number[];
    expected: Record<string, { score: number; severity: string; evidence: Record<string, unknown> }>;
  }[];
};

assert.ok(golden.cases.length >= 4, "expected golden cases");

for (const testCase of golden.cases) {
  test(`rubric golden: ${testCase.name}`, () => {
    const dataset: Dataset = {
      featureNames: testCase.feature_names,
      rows: testCase.X_train,
      target: testCase.y_train,
      targetName: "target",
    };
    const report = evaluateDataset(dataset, golden.config);
    for (const [checkId, expected] of Object.entries(testCase.expected)) {
      const actual = report.checks.find((c) => c.id === checkId);
      assert.ok(actual, `${testCase.name}: missing check ${checkId}`);
      assert.ok(
        Math.abs(actual.score - expected.score) < 1e-4,
        `${testCase.name}/${checkId}: score ${actual.score} != ${expected.score}`,
      );
      assert.equal(actual.severity, expected.severity, `${testCase.name}/${checkId}: severity`);
      for (const [key, value] of Object.entries(expected.evidence)) {
        if (typeof value === "number" && typeof actual.evidence[key] === "number") {
          const diff = Math.abs((actual.evidence[key] as number) - value);
          // Python rounds some evidence values (4 decimals, 2 for ratios) at export
          const tol = Math.max(1e-4, Math.abs(value) * 1e-3);
          assert.ok(diff <= tol, `${testCase.name}/${checkId}/${key}: ${actual.evidence[key]} != ${value}`);
        }
      }
    }
    assert.ok(report.score >= 0 && report.score <= 100);
  });
}
